{"8TWztV":["系統會根據年齡組判定您能不能存取成人內容和設定。您屬於成人年齡組，存取權限不變。",[8,"$link",["在我們的部落格瞭解更多"],[[1,"handleOnBlogHook"]]]],"qSkhZH":["系統會根據年齡組判定您能不能存取成人內容和設定。其餘 Discord 功能一切正常。請到下方查看年齡組，並",[8,"$link",["在我們的部落格瞭解更多"],[[1,"handleOnBlogHook"]]],"。"],"vGxRDB":["系統會根據年齡組判定您能不能存取成人內容和設定。其餘 Discord 功能一切正常。請到下方查看年齡組，並",[8,"$link",["在我們的部落格瞭解更多"],[[1,"handleOnBlogHook"]]],"。"],"gi4ulu":["您屬於成人年齡組 (18 歲以上)，有權存取",[8,"$link",["限制級內容、空間和設定"],[[1,"handleOnAgeGatedContentHook"]]],"。"],"221iML":["您屬於青少年年齡組 (13-17 歲)，已啟動加強保護措施，且無法存取成人",[8,"$link",["內容和設定"],[[1,"handleOnAgeGatedContentHook"]]],"。如果我們弄錯了您的年齡組，請先讓",[8,"$link",["系統確認您是成年人"],[[1,"handleOnConfirmAgeHook"]]],"。"],"W0/7DD":["您還沒確認自己的年齡組，在",[8,"$link",["系統確認您是成年人"],[[1,"handleOnConfirmAgeHook"]]],"之前，無法使用部份",[8,"$link",["成人內容和設定"],[[1,"handleOnAgeGatedContentHook"]]],"。"],"t5QjmQ":["您屬於成人年齡組"],"41MDhK":["您屬於青少年年齡組"],"m95jW8":["您還沒確認年齡組"],"iK0n30":[[1,"guildName"]," 管理員已將此頻道設為限制級頻道，僅限成人 (18 歲以上) 使用，且可能包含敏感內容。"],"ezJA0R":[[1,"guildName"]," 管理員已將此頻道設為限制級頻道，僅限成人 (18 歲以上) 使用，且可能包含敏感內容。您的帳號屬於青少年年齡組。如果我們弄錯了，請先讓系統確認您是成年人。"],"h4HbnI":[[1,"guildName"]," 管理員已將此頻道設為限制級頻道，僅限成人 (18 歲以上) 使用，且可能包含敏感內容。系統確認您是成年人後，您才能存取限制級內容、空間和設定。"],"qbBkFI":["您屬於青少年年齡組，無法變更部分設定。如果我們弄錯了，請先讓",[8,"$link",["系統確認您是成年人"],[[1,"handleOnConfirmAgeHook"]]],"。"],"HGJo1F":["只有成人年齡組才能變更部分設定。",[8,"$link",["瞭解更多"],[[1,"handleOnAgeGatedContentHook"]]]],"l+jt8J":["您屬於青少年年齡組，無法關閉訊息請求。如果我們弄錯了，請先讓",[8,"$link",["系統確認您是成年人"],[[1,"handleOnConfirmAgeHook"]]],"."],"tGsCdS":["只有成人年齡組才能關閉訊息請求。",[8,"$link",["瞭解更多"],[[1,"handleOnAgeGatedContentHook"]]]],"cI+bc/":["確認年齡"],"+7NlgO":["瞭解更多"],"GdTVPF":["我們已啟動青少年加強保護措施"],"jjpcno":["在設定中檢視"],"Ga2z/E":["我們判定您的帳號屬於青少年年齡組，故無法使用成人內容和設定。其餘 Discord 功能一切正常。",[8,"$link",["如果我們弄錯了，請先讓系統確認您是成年人"],[[1,"handleOnConfirmAgeHook"]]],"。"],"xuvWqy":["您還沒確認自己的年齡組，故無法使用部份成人內容和設定。其餘 Discord 功能一切正常。",[8,"$link",["在我們的部落格瞭解更多"],[[1,"handleOnBlogHook"]]],"。"]}