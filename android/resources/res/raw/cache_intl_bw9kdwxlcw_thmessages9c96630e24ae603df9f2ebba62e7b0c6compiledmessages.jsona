{"8TWztV":["กลุ่มอายุจะกำหนดว่าคุณสามารถเข้าถึงคอนเทนท์และการตั้งค่าสำหรับผู้ใหญ่ได้หรือไม่ คุณอยู่ในกลุ่มอายุผู้ใหญ่ จึงไม่มีอะไรเปลี่ยนแปลงสำหรับคุณ ",[8,"$link",["เรียนรู้เพิ่มเติมในบล็อกของเรา"],[[1,"handleOnBlogHook"]]]],"qSkhZH":["กลุ่มอายุจะกำหนดว่าคุณสามารถเข้าถึงคอนเทนท์และการตั้งค่าสำหรับผู้ใหญ่ได้หรือไม่ นอกเหนือจากนั้น Discord จะทำงานเหมือนเดิม ดูกลุ่มอายุของคุณด้านล่างและ",[8,"$link",["เรียนรู้เพิ่มเติมในบล็อกของเรา"],[[1,"handleOnBlogHook"]]],"."],"vGxRDB":["กลุ่มอายุจะกำหนดว่าคุณสามารถเข้าถึงคอนเทนท์และการตั้งค่าสำหรับผู้ใหญ่ได้หรือไม่ นอกเหนือจากนั้น Discord จะทำงานเหมือนเดิม ดูกลุ่มอายุของคุณด้านล่างและ",[8,"$link",["เรียนรู้เพิ่มเติมในบล็อกของเรา"],[[1,"handleOnBlogHook"]]],"."],"gi4ulu":["คุณอยู่ในกลุ่มอายุผู้ใหญ่ (18+) และสามารถเข้าถึง",[8,"$link",["คอนเทนท์ พื้นที่ และการตั้งค่าที่จำกัดอายุ"],[[1,"handleOnAgeGatedContentHook"]]]],"221iML":["คุณอยู่ในกลุ่มอายุเยาวชน (13-17) ดังนั้นคุณจึงได้รับการคุ้มครองเพิ่มเติม และ",[8,"$link",["คอนเทนท์และการตั้งค่า"],[[1,"handleOnAgeGatedContentHook"]]],"สำหรับผู้ใหญ่จะไม่พร้อมใช้งาน หากกลุ่มอายุของคุณไม่ถูกต้อง คุณสามารถ",[8,"$link",["ยืนยันว่าคุณเป็นผู้ใหญ่"],[[1,"handleOnConfirmAgeHook"]]]],"W0/7DD":["ยังไม่ได้ยืนยันกลุ่มอายุของคุณ ดังนั้น",[8,"$link",["คอนเทนท์และการตั้งค่าบางอย่าง"],[[1,"handleOnAgeGatedContentHook"]]],"สำหรับผู้ใหญ่จึงไม่พร้อมใช้งานจนกว่าคุณจะ",[8,"$link",["ยืนยันว่าคุณเป็นผู้ใหญ่"],[[1,"handleOnConfirmAgeHook"]]]],"t5QjmQ":["คุณอยู่ในกลุ่มอายุผู้ใหญ่"],"41MDhK":["คุณอยู่ในกลุ่มอายุเยาวชน"],"m95jW8":["ยังไม่ได้ยืนยันกลุ่มอายุของคุณ"],"iK0n30":["ช่องนี้ถูกจำกัดไว้สำหรับผู้ใหญ่ (18+) โดยแอดมินของ ",[1,"guildName"]," และอาจมีเนื้อหาที่ละเอียดอ่อน"],"ezJA0R":["ช่องนี้ถูกจำกัดไว้สำหรับผู้ใหญ่ (18+) โดยแอดมินของ ",[1,"guildName"]," และอาจมีเนื้อหาที่ละเอียดอ่อน บัญชีของคุณอยู่ในกลุ่มอายุวัยรุ่น หากกลุ่มอายุของคุณไม่ถูกต้อง ให้ยืนยันว่าคุณเป็นผู้ใหญ่"],"h4HbnI":["ช่องนี้ถูกจำกัดไว้สำหรับผู้ใหญ่ (18+) โดยแอดมินของ ",[1,"guildName"]," และอาจมีเนื้อหาที่ละเอียดอ่อน ยืนยันว่าคุณเป็นผู้ใหญ่เพื่อเข้าถึงเนื้อหา พื้นที่ และการตั้งค่าที่จำกัดอายุ"],"qbBkFI":["คุณอยู่ในกลุ่มอายุวัยรุ่น จึงไม่สามารถเปลี่ยนการตั้งค่าบางอย่างได้ หากข้อมูลนี้ดูไม่ถูกต้อง คุณสามารถ",[8,"$link",["ยืนยันว่าคุณเป็นผู้ใหญ่"],[[1,"handleOnConfirmAgeHook"]]],"."],"HGJo1F":["การตั้งค่าบางอย่างจะเปลี่ยนได้เฉพาะเมื่อคุณอยู่ในกลุ่มอายุผู้ใหญ่ ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"handleOnAgeGatedContentHook"]]]],"l+jt8J":["คุณอยู่ในกลุ่มอายุวัยรุ่น จึงไม่สามารถปิดคำขอข้อความได้ หากข้อมูลนี้ดูไม่ถูกต้อง คุณสามารถ",[8,"$link",["ยืนยันว่าคุณเป็นผู้ใหญ่"],[[1,"handleOnConfirmAgeHook"]]],"."],"tGsCdS":["สามารถปิดคำขอข้อความได้เฉพาะเมื่อคุณอยู่ในกลุ่มอายุผู้ใหญ่ ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"handleOnAgeGatedContentHook"]]]],"cI+bc/":["ยืนยันอายุ"],"+7NlgO":["เรียนรู้เพิ่มเติม"],"GdTVPF":["เราได้เปิดตัวมาตรการปกป้องเพิ่มเติมสำหรับวัยรุ่น"],"jjpcno":["ดูในการตั้งค่า"],"Ga2z/E":["บัญชีของคุณอยู่ในกลุ่มอายุวัยรุ่น ดังนั้นคอนเทนท์และการตั้งค่าสำหรับผู้ใหญ่จึงไม่พร้อมใช้งาน นอกเหนือจากนี้ Discord ใช้งานได้เหมือนเดิม ",[8,"$link",["หากเราเข้าใจผิด โปรดยืนยันว่าคุณเป็นผู้ใหญ่"],[[1,"handleOnConfirmAgeHook"]]]],"xuvWqy":["กลุ่มอายุของคุณยังไม่ได้รับการยืนยัน ดังนั้นคอนเทนท์และการตั้งค่าบางอย่างสำหรับผู้ใหญ่จึงไม่พร้อมใช้งาน นอกเหนือจากนี้ Discord ใช้งานได้เหมือนเดิม ",[8,"$link",["เรียนรู้เพิ่มเติมในบล็อกของเรา"],[[1,"handleOnBlogHook"]]]]}