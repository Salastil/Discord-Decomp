{"5Mi5TE":["Да променим ли начина, по който определяме възрастта ти?"],"lG69e1":[[8,"$link",["Научи повече"],[[1,"handleOnHelpUrlHook"]]]," за възрастовите групи"],"V822Mp":["Премахни възрастовата група"],"FbTAmI":["Това ще промени възрастовата ти група от „Възрастни“ на „Непотвърдена“ и няма да имаш достъп до преживявания с възрастово ограничение. За да си върнеш достъпа за възрастни, ще трябва да потвърдиш възрастовата си група с друг метод."],"Gn0SAj":["Задай възрастовата си група като „Непотвърдена“"],"bD//cU":["Премахване на определената възрастова група"],"rJiO86":["Избери да потвърдиш възрастовата си група с различен метод"],"SH6Tcv":["Потвърждаване на възрастова група"],"1DN29p":["Използваме технологии, които оценяват възрастовите групи на потребителите въз основа на модели на поведение и други сигнали, свързани с акаунти на потребители в Discord. ",[8,"$link",["Научи повече"],[[1,"handleOnHelpUrlHook"]]]],"PY4MA0":["Discord ти зададе възрастова група „Възрастни“"],"FTawSP":["Зададено от Discord"],"VcZF1q":["Продължи в другия прозорец. Ако искаш да избереш друг метод за потвърждаване на възрастта, затвори прозореца и се върни тук."],"MLPgsX":["Потвърждаваш възрастта си в друг прозорец"],"9F2y52":["Не успяхме да потвърдим възрастта ти със селфи. Ще опиташ ли пак?"],"40UKek":["Не успяхме да потвърдим възрастта ти със сканиране на документ за самоличност. Ще опиташ ли пак?"],"yBHwMy":["Тази стъпка не се поддържа на VR. Завърши я на друго устройство и автоматично ще актуализираме изживяването ти тук."],"gUqXQN":["Потвърди възрастта си на друго устройство"],"Jx33+I":["Опитай друг метод"],"XBGt7g":["Установихме, че си под минималната възраст за Discord."],"tBwanH":["Не успяхме да потвърдим възрастовата ти група чрез App Store. Опитай с друг метод."],"MN6I4Y":["Потвърждаване на възрастовата ти група…"],"RpMIT0":["Избери метод, с който да потвърдиш, че си пълнолетен(а). След потвърждението ще имаш достъп до съдържание с възрастово ограничение и настройки. ",[8,"$link",["Научи повече"],[[1,"handleOnHelpUrlHook"]]],"."],"h7qzoa":["Възстанови достъпа до Discord, като потвърдиш възрастта си, използвайки една от опциите по-долу."],"+Ft5ch":["Ако потвърдиш, че си пълнолетен(на) (18+), ще имаш достъп до съдържание и настройки с възрастово ограничение. Нуждаеш се от помощ? Виж ",[8,"$link",["как да потвърдиш"],[[1,"handleOnHelpUrlHook"]]]," или научи повече за нашите ",[8,"$link",["доверени доставчици"],[[1,"handleOnTrustedProvidersHook"]]],"."],"22HSSI":["Ако потвърдиш, че си пълнолетен(на) (18+), ще имаш достъп до съдържание и настройки с възрастово ограничение. Нуждаеш се от помощ? Виж ",[8,"$link",["как да потвърдиш"],[[1,"handleOnHelpUrlHook"]]],"."],"/kgWIg":["Потвърди възрастовата си група"],"eJmat5":["Определи възрастта си с видеоселфи. Видеоклипът остава на устройството и не се споделят биометрични данни."],"2yLvkS":["Видеоселфи чрез k-ID"],"+pwfOA":["Нещо се обърка с потвърждаването в Google Wallet. Опитай друг метод."],"dah4bF":["Използвай ID пропуск, базиран на информацията от твоя паспорт. Данните за твоя ID се съхраняват в Google Wallet."],"Y9sLpR":["ID пропуск в Google Wallet"],"fEUKEv":["Опитай друг метод"],"Pf5xUq":["Твоят документ за самоличност е издаден в държава, която все още не се поддържа. Опитай друг метод за потвърждение."],"MlFuBI":["Потвърждаване на възрастта ти…"],"ZdmRwW":["Сканирай своя документ за самоличност (ID) и направи селфи, за да потвърдиш, че това си ти. И двете се изтриват веднага след потвърждението и никога не се свързват с акаунта ти."],"dwkwo0":["Сканирам ID чрез k-ID"],"ARmJ0M":["Използвай шофьорска книжка, паспорт или друг официален документ за самоличност."],"NeVlw/":["Сканирай своя документ за самоличност"],"eZvwAe":["Как искаш да потвърдиш възрастта си?"],"5yWXmT":["Избери опцията, която е най-подходяща за теб."],"fm7qBC":["Най-бързият вариант. Биометричните ти данни се обработват локално и никога не напускат устройството ти."],"rgXXcW":["Направи си селфи"],"htWh1G":[[8,"$link",["Научи повече"],[[1,"handleOnHelpUrlHook"]]]," в нашия Помощен център"],"Bkmk4Y":["Нещо се обърка при зареждането на методите за потвърждение. Опитай отново."],"vVwFCK":["Този метод вече не е достъпен."],"cR6336":["Няма налични методи за потвърждаване на възраст. Моля, провери пак след малко."],"hDvmYP":["Презареждане"]}