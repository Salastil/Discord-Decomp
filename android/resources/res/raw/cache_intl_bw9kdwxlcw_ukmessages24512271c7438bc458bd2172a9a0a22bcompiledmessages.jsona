{"5Mi5TE":["Змінити спосіб визначення вашого віку?"],"lG69e1":[[8,"$link",["Докладніше"],[[1,"handleOnHelpUrlHook"]]]," про вікові групи"],"V822Mp":["Видалити вікову групу"],"FbTAmI":["Це змінить вашу вікову групу з «Дорослі» на «Не підтверджено», і ви не зможете отримати доступ до контенту з віковими обмеженнями. Щоб відновити доступ для дорослих, вам потрібно буде підтвердити свою вікову групу іншим способом."],"Gn0SAj":["Встановіть свою вікову групу як «Не підтверджено»"],"bD//cU":["Видалити призначену вікову групу"],"rJiO86":["Оберіть інший метод підтвердження вашої вікової групи"],"SH6Tcv":["Підтвердьте вікову групу"],"1DN29p":["Ми використовуємо технології, які оцінюють вікові групи користувачів на основі шаблонів поведінки та інших сигналів, пов'язаних з акаунтами користувачів у Discord. ",[8,"$link",["Докладніше"],[[1,"handleOnHelpUrlHook"]]]],"PY4MA0":["Вам призначено вікову групу «Дорослі» від Discord"],"FTawSP":["Призначено Discord"],"VcZF1q":["Продовжте в іншому вікні. Якщо хочете вибрати інший метод підтвердження віку, закрийте те вікно й поверніться сюди."],"MLPgsX":["Ви підтверджуєте вік в іншому вікні"],"9F2y52":["Не вдалося підтвердити ваш вік через селфі. Спробувати ще раз?"],"40UKek":["Не вдалося підтвердити ваш вік через сканування посвідчення. Спробувати ще раз?"],"yBHwMy":["Цей крок не підтримується у VR. Виконайте його на іншому пристрої і ми оновимо ваш прогрес тут автоматично."],"gUqXQN":["Підтвердьте свій вік на іншому пристрої"],"Jx33+I":["Спробувати інший метод"],"XBGt7g":["Ми визначили, що ви ще не досягли вікового мінімуму Discord."],"tBwanH":["Ми не змогли підтвердити вашу вікову групу з App Store. Спробуйте інший спосіб."],"MN6I4Y":["Підтвердження вашої вікової групи…"],"RpMIT0":["Виберіть спосіб підтвердження повноліття. Після підтвердження ви отримаєте доступ до матеріалів та налаштувань із віковими обмеженнями. ",[8,"$link",["Докладніше"],[[1,"handleOnHelpUrlHook"]]],"."],"h7qzoa":["Відновіть доступ до Discord, підтвердивши свій вік за допомогою одного з наведених нижче параметрів."],"+Ft5ch":["Якщо ваше повноліття (18+) буде підтверджено, у вас з'явиться доступ до матеріалів та налаштувань із віковими обмеженнями. Потрібна допомога? Перегляньте ",[8,"$link",["інформацію про підтвердження віку"],[[1,"handleOnHelpUrlHook"]]]," чи почитайте про наших ",[8,"$link",["надійних постачальників"],[[1,"handleOnTrustedProvidersHook"]]],"."],"22HSSI":["Якщо ваше повноліття (18+) буде підтверджено, у вас з'явиться доступ до матеріалів та налаштувань із віковими обмеженнями. Потрібна допомога? Перегляньте ",[8,"$link",["інформацію про підтвердження віку"],[[1,"handleOnHelpUrlHook"]]],"."],"/kgWIg":["Підтвердьте вашу вікову групу"],"eJmat5":["Оцінка віку за допомогою відеоселфі. Відео залишається на пристрої, біометричні дані не поширюються."],"2yLvkS":["Відеоселфі через k-ID"],"+pwfOA":["Щось пішло не так із верифікацією Google Wallet. Будь ласка, спробуйте інший спосіб."],"dah4bF":["Використовуйте посвідчення особи на основі даних вашого паспорта. Дані вашого посвідчення залишаться в Google Wallet."],"Y9sLpR":["Цифрове посвідчення в Google Wallet"],"fEUKEv":["Спробуйте інший метод"],"Pf5xUq":["Ваш посвідчення особи було видано в країні, яка ще не підтримується. Будь ласка, спробуйте інший метод верифікації."],"MlFuBI":["Верифікація вашого віку…"],"ZdmRwW":["Відскануйте своє посвідчення особи та зробіть селфі, щоб підтвердити, що це саме ви. Обидва знімки будуть видалені одразу після підтвердження і ніколи не будуть пов'язані з вашим акаунтом."],"dwkwo0":["Сканування посвідчення через k-ID"],"ARmJ0M":["Скористайтеся посвідченням водія, паспортом або іншим державним документом, що посвідчує особу."],"NeVlw/":["Відскануйте своє посвідчення особи"],"eZvwAe":["Як ви хочете підтвердити свій вік?"],"5yWXmT":["Виберіть спосіб, що пасує вам найбільше."],"fm7qBC":["Найшвидший варіант. Ваші біометричні дані обробляються локально й ніколи не залишають пристрій."],"rgXXcW":["Зробити селфі"],"htWh1G":[[8,"$link",["Діз