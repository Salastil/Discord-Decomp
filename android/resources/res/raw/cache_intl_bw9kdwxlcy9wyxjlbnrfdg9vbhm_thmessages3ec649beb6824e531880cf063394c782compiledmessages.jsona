"หลังจากเชื่อมต่อแล้ว ผู้ปกครองของคุณจะสามารถเห็นกิจกรรมของคุณในเรียนรู้เพิ่มเติมได้ ",[8,"$link",["ดูข้อมูลเพิ่มเติม"],[[1,"link"]]]],"Hsm5IF":["ปิด"],"aCUVfL":["เชื่อมต่อผู้ปกครองกับบัญชี Discord ของคุณ"],"6mK5Pz":["ช่วยให้เราสามารถปรับแต่งเนื้อหาที่ได้รับการสนับสนุน เช่น ภารกิจ ให้เป็นแบบเฉพาะบุคคลโดยใช้ข้อมูลที่เราได้รับจากผู้ลงโฆษณาและผู้ให้บริการข้อมูลบุคคลที่สาม หากคุณเลือกไม่เข้าร่วม บุตรหลานคุณอาจยังคงเห็นภารกิจอยู่ แต่จะไม่ได้รับการปรับแต่งโดยใช้ข้อมูลจากบุคคลที่สาม ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"helpdeskArticle"]]]],"Imp6Ns":["อนุญาตให้เราใช้ข้อมูล เช่น บุคคลที่บุตรหลานของคุณพูดคุยด้วย และเกมที่พวกเขาเล่น เพื่อปรับแต่ง Discord ให้เหมาะกับพวกเขามากขึ้น ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"helpdeskArticle"]]]],"Z5yJZy":["อนุญาตให้เราใช้และประมวลผลข้อมูลของบุตรหลานของคุณเพื่อทำความเข้าใจและพัฒนาบริการของเราให้ดียิ่งขึ้น ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"helpdeskArticle"]]]],"i284fU":["การตั้งค่าบางอย่างถูกจัดการโดยผู้ปกครองของคุณ ปรึกษาผู้ปกครองเพื่อทำการเปลี่ยนแปลง ",[8,"hook",["ส่งข้อความถึงผู้ปกครอง"]]],"ZhaNu8":["ใช้กิจกรรมของบุตรหลานของฉันบน Discord เพื่อปรับแต่งเนื้อหาที่ได้รับการสนับสนุน"],"cnCK6b":["อนุญาตให้เราปรับแต่งเนื้อหาที่ได้รับการสนับสนุน เช่น ภารกิจ โดยใช้กิจกรรมของบุตรหลานของคุณบน Discord เช่น เกมที่พวกเขาเล่น หากคุณเลือกไม่เข้าร่วม บุตรหลานของคุณอาจยังคงเห็นเควสต์อยู่ แต่จะไม่ถูกปรับแต่งเป็นพิเศษ ",[8,"$link",["เรียนรู้เพิ่มเติม"],[[1,"helpdeskArticle"]]]],"ahKIJO":["การควบคุมโดยผู้ปกครอง"],"7aYkh1":["กรองข้อความจากสมาชิกในเซิร์ฟเวอร์ที่บุตรหลานของคุณอาจไม่รู้จัก"],"Sv236e":["คุณสามารถจัดการการตั้งค่าบางอย่างสำหรับบัญชีของบุตรหลานได้ บุตรหลานของคุณจะไม่สามารถปรับเปลี่ยนการตั้งค่าเฉพาะเหล่านี้ได้ด้วยตนเอง เราขอแนะนำให้คุณพูดคุยกับบุตรหลานเกี่ยวกับวิธีปรับแต่งการตั้งค่าเหล่านี้"],"w0JA3P":["ข้อความหลัก"],"X9rW0j":[[8,"openSettingsHook",["การตั้งค่า"]],"บางอย่างถูกจัดการโดยผู้ปกครองของคุณ ปรึกษาผู้ปกครองเพื่อทำการเปลี่ยนแปลง"],"1xBHHV":["คุณจะไม่เห็นเนื้อหาของข้อความหรือสายโทรของบุตรหลานของคุณ"],"0QDVFN":["ผู้ปกครองของคุณจะไ