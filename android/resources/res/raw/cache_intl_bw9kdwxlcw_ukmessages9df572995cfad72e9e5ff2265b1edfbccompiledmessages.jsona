{"8TWztV":["Вікові групи визначають, чи матимете ви доступ до матеріалів та налаштувань для дорослих. Ви належите до дорослої вікової групи, тому для вас нічого не змінюється. ",[8,"$link",["Докладніше в нашому блозі"],[[1,"handleOnBlogHook"]]]],"qSkhZH":["Вікові групи визначають, чи матимете ви доступ до матеріалів та налаштувань для дорослих. У всьому іншому Discord не змінюється. Перегляньте свою вікову групу нижче та ",[8,"$link",["дізнайтеся більше в нашому блозі"],[[1,"handleOnBlogHook"]]],"."],"vGxRDB":["Вікові групи визначають, чи матимете ви доступ до матеріалів та налаштувань для дорослих. У всьому іншому Discord не змінюється. Перегляньте свою вікову групу нижче та ",[8,"$link",["дізнайтеся більше в нашому блозі"],[[1,"handleOnBlogHook"]]],"."],"gi4ulu":["Ви належите до дорослої вікової групи (18+) та маєте доступ до ",[8,"$link",["матеріалів, майданчиків і налаштувань із віковими обмеженнями"],[[1,"handleOnAgeGatedContentHook"]]],"."],"221iML":["Ви належите до підліткової вікової групи (13–17), тому у вас є додатковий захист, а ",[8,"$link",["вміст і налаштування"],[[1,"handleOnAgeGatedContentHook"]]],", призначені для дорослих, недоступні. Якщо ваша вікова група вказана неправильно, ви можете ",[8,"$link",["підтвердити, що ви повнолітні"],[[1,"handleOnConfirmAgeHook"]]],"."],"W0/7DD":["Вашу вікову групу ще не підтверджено, тож ",[8,"$link",["деякі матеріали й налаштування"],[[1,"handleOnAgeGatedContentHook"]]],", призначені для дорослих, недоступні, доки ви не ",[8,"$link",["підтвердите повноліття"],[[1,"handleOnConfirmAgeHook"]]],"."],"t5QjmQ":["Ви належите до дорослої вікової групи"],"41MDhK":["Ви належите до підліткової вікової групи"],"m95jW8":["Ваша вікова група не підтверджена"],"iK0n30":["Цей канал доступний лише дорослим (18+) за рішенням адміністраторів сервера ",[1,"guildName"]," і може містити контент делікатного характеру."],"ezJA0R":["Цей канал доступний лише дорослим (18+) за рішенням адміністраторів сервера ",[1,"guildName"]," і може містити контент делікатного характеру. Ваш акаунт належить до підліткової вікової групи. Якщо ваша вікова група вказана неправильно, підтвердьте своє повноліття."],"h4HbnI":["Цей канал доступний лише дорослим (18+) за рішенням адміністраторів сервера ",[1,"guildName"]," і може містити контент делікатного характеру. Підтвердьте своє повноліття, щоб отримати доступ до матеріалів, майданчиків і налаштувань із віковим обмеженням."],"qbBkFI":["Ви належите до підліткової вікової групи, через що деякі налаштування не можуть бути змінені. Якщо вікову групу визначено помилково, ви можете ",[8,"$link",["підтвердити повноліття"],[[1,"handleOnConfirmAgeHook"]]],"."],"HGJo1F":["Деякі налаштування можна змінити лише в разі приналежності до дорослої вікової групи. ",[8,"$link",["Докладніше"],[[1,"handleOnAgeGatedContentHook"]]],"."],"l+jt8J":["Ви належите до підліткової вікової групи, тому запити на спілкування неможливо вимкнути. Якщо вікову групу визначено помилково, ви можете ",[8,"$link",["підтвердити своє повноліття"],[[1,"handleOnConfirmAgeHook"]]],"."],"tGsCdS":["Запити на спілкування можна вимкнути лише в разі приналежності до дорослої вікової групи. ",[8,"$link",["Докладніше"],[[1,"handleOnAgeGatedContentHook"]]]],"cI+bc/":["Підтвердити вік"],"+7NlgO":["Дізнатися більше"],"GdTVPF":["Ми запровадили додаткові заходи захисту підлітків"],"jjpcno":["Переглянути в налаштуваннях"],"Ga2z/E":["Ваш акаунт належить до підліткової вікової групи, тому матеріали й налаштування для дорослих недоступні. В іншому Discord працює як завжди. ",[8,"$link",["Якщо ми помилилися, підтвердьте, що ви повнолітні."],[[1,"handleOnConfirmAgeHook"]]]],"xuvWqy":["Вашу вікову групу ще не підтверджено, тому деякі матеріали й налаштування для дорослих недоступні. В іншому Discord працює як завжди. ",[8,"$link",["Дізнайтеся більше в нашому блозі."],[[1,"handleOnBlogHook"]]]]}