{"B9PPxE":["Innholdet er skjult."],"Y9ZOp8":["Innholdet vises."],"pmIitA":["Spill med ekte penger"],"z/MfaY":["Discord lar deg styre visning av annonser knyttet til bestemte emner. Hvis du skjuler et emne under, kommer du ikke til å se sponset innhold om emnet. Discords retningslinjer for annonser gjør at noe innhold kan vises uavhengig av hvilke valg du tar. ",[8,"$link",["Mer info"],[[1,"helpdeskArticle"]]]],"yyhs9L":["Administrer sponset innhold"],"OkmBx0":["Emner"],"XUj46U":["Sponset innhold"]}