{"B9PPxE":["Цей контент наразі прихований."],"Y9ZOp8":["Цей контент наразі видно всім."],"pmIitA":["Ігри за реальні гроші"],"z/MfaY":["У Discord ви можете керувати відображенням спонсорованого контенту на певні теми. Якщо ви приховаєте тему нижче, то не бачитимете спонсорованого контенту з нею. Політика Discord щодо реклами впливає на певний контент, який ви бачите, незалежно від цих налаштувань. ",[8,"$link",["Дізнатися більше"],[[1,"helpdeskArticle"]]]],"yyhs9L":["Керувати спонсорованим контентом"],"OkmBx0":["Теми"],"XUj46U":["Спонсорований контент"]}