{"Tk6x4X":["ティーン（13～19歳）のお子様は、今月すでに",[1,"amount"],"を使用しています。この金額より低い上限を設定すると、サブスクリプション以外のすべての購入が",[1,"date"],"までブロックされます。"],"IFguF2":["お子様が毎月Discordでいくら支払いできるかを管理します。サブスクリプションには適用されません。"],"pfAlRY":["今月の支払い額は",[1,"amount"],"です。"],"JZDGJ8":["支出上限を無効化"],"37z4a2":["ダウンタイム時間"],"72CmJd":["ダウンタイムのスケジュール"],"C4ScLD":["つながっている家族メンバーはまだいません。"],"pu6/U0":["つながっている10代のユーザー — ",[2,"count"],"人 / ",[1,"max"],"人"],"+tnO34":["つながっている保護者 — ",[2,"count"],"人 / ",[1,"max"],"人"],"Y3ZYtM":[[1,"date"],"につながりました"],"WRtySz":[[2,"count"]," 日前につながりました"],"J18GbG":[[2,"count"]," 時間前につながりました"],"kX3wJg":[[2,"count"]," 分前につながりました"],"Bqsamd":["1分未満の間につながりました"],"Ln9zMn":["昨日、つながりました"],"snlFqR":["この申請を受け入れることで、アカウントがファミリーセンターでつながる",[1,"username"],"とつながることに同意します。このユーザーとのつながりを切断することで、いつでも同意を撤回できることを理解しています。"],"rlNJwZ":["下記の保護者のつながりを許可する:"],"wI/jo3":["申請を受け入れ"],"jc1Ip7":[[1,"name"],"からの申請を受け入れ"],"oUpA6X":[[1,"name"],"の申請をキャンセル"],"4GtllP":[[1,"name"],"からの申請を拒否"],"T7DUoU":[[1,"name"],"からのつながりを切断"],"kIcKAj":["新しいフレンド"],"TEvo+H":["新しいフレンド — ",[2,"count"],"人"],"BkVb1X":["ティーン（13～19歳）のお子様が追加または承認した新しいフレンド"],"mpHHfa":["追加または承認した新しいフレンド"],"EMCf6j":["ファミリーセンターは、10代のお子様のDiscord使用状況に関する詳細情報を提供し、オンラインでの好ましい行動の実践について共に取り組めるよう築かれました。",[8,"$link",["詳しくはこちら"],[[1,"articleLink"]]]],"MXjDSv":["つながっている家族メンバーがあなたのメッセージの内容を閲覧することはありません。このファミリーセンターダッシュボードにアクセスすることで、家族メンバーが閲覧できる内容をいつでも確認できます。",[8,"$link",["詳しくはこちら"],[[1,"articleLink"]]]],"goKE2b":["10代のお子様のDiscord使用状況について、最新情報を把握しましょう。"],"T7GyW+":["プライバシーを守りながら、保護者に最新情報を共有しましょう。"],"obi47v":["アバターデコレーション"],"VS1fKo":["バンドル"],"nNGEHk":["ネームプレート"],"RX8BMR":["プロフィールエフェクト"],"JiIY1l":["プロフィールフレーム"],"ULUspo":["受け取ったギフト"],"0R6I/b":["受け取ったギフト — ",[1,"amount"]],"nH8vlc":["過去1週間に受信したすべてのギフトと、送信したユーザーおよび相手が支払った金額です。"],"kDyllq":["入手日：",[1,"date"]],"o44n/1":[[1,"price"],"（提供者：",[1,"username"],"）"],"gAG45y":[[1,"date"],"から未入手"],"CcrbCw":["アクティブサーバー"],"rcPInc":["アクティブサーバー — ",[2,"count"],"件"],"BLgIrk":["ティーン（13～19歳）のお子様が音声通話またはビデオ通話に参加した、あるいはメッセージを送信したサーバー。"],"sSJauZ":["音声通話またはビデオ通話に参加した、あるいはメッセージを送信したサーバー。保護者の方はアクティブなサーバーの名前のみを確認できますが、ここからサーバーをクリックしたり参加したりすることはできません。"],"uav9Bh":["新しいサーバー"],"7feG7T":["新サーバー — ",[2,"count"]],"LVNgTD":["ティーン（13～19歳）のお子様が参加または作成した新しいサーバー。"],"TA8GFt":["参加または作成した新しいサーバー。保護者の方はサーバーの名前のみを確認できますが、ここからサーバーをクリックしたり参加したりすることはできません。"],"5JmNgg":[[2,"members"]," メンバー"],"7dMmJY":["さらに",[2,"pageSize"],"ページ表示"],"n8n5Ba":["過去",[1,"days"],"日間のアクティビティ"],"2AtcIs":["今日のアクティビティ"],"stOECr":["昨日以降のアクティビティ"],"f1UJiC":["あなたの過去",[1,"days"],"日間のアクティビティ"],"g1ZX6m":["あなたの今日のアクティビティ"],"s3qSVt":["あなたの昨日以降のアクティビティ"],"KrLnkE":["アクティビティ要約"],"tazvHQ":[[2,"activeLinks"],"家族人が閲覧可能"],"NMYKsh":["総購入"],"FPViWL":["総購入 — ",[1,"amount"]],"cqIdqZ":["先週ティーン（13～19歳）のお子様が行ったすべての購入（ショップやサブスクリプションなど）です。Nitroサブスクリプションは、あなたのアカウントに請求された週に表示されます。"],"85PtWu":["先週行ったすべての購入（ショップやサブスクリプションなど）です。Nitroサブスクリプションは、あなたのアカウントに請求された週に表示されます。"],"bdBmqy":["アクティビティ"],"IYqGMG":[[2,"messageCount"],"件のメッセージ • ",[2,"callCount"],"件の通話"],"L/Cj7S":[[2,"callCount"],"件の通話"],"6X1F0i":[[2,"messageCount"],"件のメッセージ"],"Lq9Set":["トップサーバー"],"BxbvS7":["トップユーザー"],"fwQgE/":[[2,"days"],"日前に追加されました"],"JUHIYZ":["今日追加されました"],"GiswUW":["昨日追加されました"],"D7Sngz":["コールを行ったユーザー"],"0GE4Ni":["コールを行ったユーザー — ",[2,"count"],"人"],"oCk8c4":["最後のコールは",[2,"days"],"日前に行われました"],"IHd5cZ":["最後のコールは今日行われました"],"wOsfxv":["最後のコールは昨日行われました"],"aiAhnQ":["ティーン（13～19歳）のお子様が1対1またはグループチャットで音声通話あるいはビデオ通話をしたユーザー。サーバーは含まれません。"],"4ufgdz":["1対1またはグループチャットで音声通話あるいはビデオ通話をしたユーザー。サーバーは含まれません。"],"kvTgWP":["メッセージを行ったユーザー"],"4T3zWT":["メッセージを送信した相手のユーザー — ",[2,"count"],"人"],"w4wmnb":["ティーン（13～19歳）のお子様が1対1またはグループチャットでメッセージを送信したユーザー。サーバーは含まれません。"],"foTzbd":["1対1またはグループチャットでメッセージを送信したユーザー。サーバーは含まれません。"],"qvKjp8":["最後のメッセージは",[2,"days"],"日前に行われました"],"fLBUx7":["最後のメッセージは今日行われました"],"cHHgxI":["最後のメッセージは昨日行われました"],"eo4Fxh":["音声・ビデオ"],"eGFWUd":["音声時間（分） — ",[2,"count"]],"O/AElu":["ダイレクトメッセージ、グループチャット、サーバー全体で通話に費やした分数"],"kFj4h1":[[1,"name"],"のアバター"],"HynllX":["保護者によるつながり申請をキャンセルしますか？"],"mK40bk":["申請をキャンセル"],"czincX":["何もしない"],"3oUE4o":["年齢を確認"],"0o3yg8":["Discordでつながりのある保護者となるには18歳以上である必要があります。つながった後は、つながったティーンのユーザーのアクティビティ情報の確認や、所定の設定管理の支援ができます。",[8,"$link",["詳細はこちら"],[[1,"link"]]]],"pQQMJ7":["Discordで",[1,"username"],"の保護者としてつながりましょう"],"RfkLDs":["(新)コード内に"],"XhROZk":["または"],"lggBOi":["またはリンクを共有"],"lVD5Nd":[[1,"username"],"がDiscordで保護者としてつながりの招待をしています。",[1,"url"]],"2O6ltn":["連携後、保護者の方がファミリーセンターであなたのアクティビティを表示できるようになります。",[8,"$link",["詳細はこちら"],[[1,"link"]]]],"Hsm5IF":["閉じる"],"aCUVfL":["保護者をあなたのDiscordアカウントに連携"],"6mK5Pz":["Discordが広告主やサードパーティのデータプロバイダーから受け取ったデータを使用して、クエストなどのスポンサーコンテンツをパーソナライズすることを許可します。オプトアウトした場合でも、クエストはティーン（13～19歳）のお子様に対して表示されますが、サードパーティのデータを使ったパーソナライズは行われません。",[8,"$link",["詳細はこちら"],[[1,"helpdeskArticle"]]]],"Imp6Ns":["Discordがティーン（13～19歳）のお子様の話す相手やプレイするゲームなどの情報を使用して、Discordをお子様用にパーソナライズすることを許可します。",[8,"$link",["詳細はこちら"],[[1,"helpdeskArticle"]]]],"Z5yJZy":["Discordがティーン（13～19歳）のお子様の情報を使用および処理して、サービスの理解と改善に役立てることを許可します。",[8,"$link",["詳細はこちら"],[[1,"helpdeskArticle"]]]],"i284fU":["一部の設定は保護者の方に管理されています。変更するには、保護者の方にご確認ください。",[8,"hook",["保護者の方にメッセージを送信"]],"しましょう。"],"ZhaNu8":["ティーン（13～19歳）のお子様のDiscordでのアクティビティを使用して、スポンサーコンテンツをパーソナライズ"],"cnCK6b":["Discordがティーン（13～19歳）のお子様がプレイするゲームなどのDiscordでのアクティビティのデータを使用して、クエストなどのスポンサーコンテンツをパーソナライズすることを許可します。オプトアウトした場合でも、クエストはお子様に対して表示されますが、サードパーティのデータを使ったパーソナライズは行われません。",[8,"$link",["詳細はこちら"],[[1,"helpdeskArticle"]]]],"ahKIJO":["ペアレンタルコントロール"],"7aYkh1":["ティーン（13～19歳）のお子様が知らない可能性のあるサーバーメンバーからのメッセージをフィルターします"],"Sv236e":["ティーン（13～19歳）のお子様のアカウントの、特定の設定を管理できます。ティーンのお子様ご自身ではこれらの設定を変更できません。これらの設定をどのようにカスタマイズするか、お子様と会話することをお勧めします。"],"w0JA3P":["保護者にメッセージ"],"X9rW0j":["一部の",[8,"openSettingsHook",["設定"]],"は保護者の方に管理されています。変更するには、保護者の方にご確認ください。"],"1xBHHV":["ティーン（13～19歳）のお子様のメッセージや通話の内容を閲覧することはできません。"],"0QDVFN":["保護者の方があなたのメッセージや通話の内容を閲覧することはありません。"],"82y87X":["10代のお子様が書いた、または話した内容"],"ASf7XN":["あなたが書いた、または話した内容"],"n73g+V":["保護者の方は閲覧しません"],"WZwGFX":["ティーン（13～19歳）のお子様が追加または承認した新しいフレンド"],"5x3taM":["追加または承認した新しいフレンド"],"/zMYZX":["新しいフレンド"],"yFnKIg":["ティーン（13～19歳）のお子様が過去1週間に受信したすべてのギフトと、送信したユーザーおよび相手が支払った金額"],"GWPcQg":["あなたが過去1週間に受信したすべてのギフトと、送信したユーザーおよび相手が支払った金額"],"Fv3n8L":["受け取ったギフト"],"PQtDFk":["ティーン（13～19歳）のお子様が最近作成した、参加した、メッセージを送信した、音声通話およびビデオ通話に参加したサーバーなど"],"FcKkcr":["あなたが最近作成した、参加した、メッセージを送信した、音声通話およびビデオ通話に参加したサーバーなど"],"44NEx6":["参加した、または参加しているサーバー"],"CI1Env":["つながっている保護者が確認できる内容"],"ksze+o":["保護者の方が管理できる内容"],"ep6mdN":["ティーン（13～19歳）のお子様が行った全ての購入（ショップ購入やサブスクリプションなど）"],"dES/2r":["これまでに行った全ての購入（ショップやサブスクリプションなど）"],"PjM3r5":["総購入"],"TeNlMb":["お子様が提出した通報を共有することを選択した場合、あなたにメールで通知されます"],"tHTyRh":["通報を提出した後、通報を共有することができます。共有することを選択した場合は、保護者の方にメールで通知されます"],"0cuLn1":["ティーン（13～19歳）のお子様が共有した通報"],"30+sih":["あなたが共有した通報"],"f7ofm/":["Discordが利用できない日と時間帯を選択して、ティーン（13～19歳）のお子様に休憩を与えます。"],"PfveQ6":["保護者の方は、Discordを利用できない時間をスケジュールできます。この時間を使って休憩し、リフレッシュしましょう。"],"kyT6pZ":["スクリーン時間制限"],"tdgcf1":["ティーン（13～19歳）のお子様のアカウントについて、お子様ご自身では編集できない特定の設定を管理できます。"],"wZejZr":["あなたのアカウントについて、保護者の方はあなた自身では編集できない一部の設定を管理できます。"],"UCuHM8":["ティーンアカウント設定"],"HdcGGl":["ティーン（13～19歳）のお子様のDiscordでの購入（ショップアイテムやギフトなど）に月ごとの予算を設定できます。サブスクリプションは含まれません。"],"MKeCj3":["保護者の方は、あなたのDiscordでの購入（ショップアイテムやギフトなど）に月ごとの予算を設定できます。サブスクリプションは含まれません。"],"52ld7c":["支出上限"],"KBgArX":["これにはダイレクトメッセージとグループチャットが含まれます"],"Z3G+8h":["メッセージを送信した、または通話したユーザー"],"Ief2xc":["ダイレクトメッセージのグループチャット全体およびサーバーで通話に費やした分数"],"GNs2ZH":["音声またはビデオで過ごした総時間"],"LcM8BS":["保護者からの申請を拒否すると、申請を拒否したという通知が相手に送られます。"],"cXgKMD":["通知"],"teIRCR":["保護者によるつながり申請を拒否しますか？"],"dKxFcn":["拒否"],"c5L+sl":["切断"],"PlrZal":[[1,"username"],"さんとのつながりを切断すると、相手を削除したという通知が相手に送信されます。また、相手のDiscordアクティビティに関する情報へのアクセスも取り消されます。"],"XyRW4c":[[1,"username"],"さんとのつながりを切断すると、相手を削除したという通知が相手に送信されます。また、あなたのDiscordアクティビティに関する情報への相手のアクセスも取り消されます。"],"PGQBnk":["Discordの必須要件として、このティーン（13～19歳）ユーザーが引き続きDiscordを利用するには1人以上の保護者がそのアカウントにつながっている必要があることを、理解しています。"],"eiABQz":["Discordの必須要件として、私が引き続きDiscordを利用するには1人以上の保護者が私のアカウントにつながっている必要があることを、理解しています。"],"0ki7+P":["このティーン（13～19歳）ユーザーとのつながりを切断すると、相手のDiscordアクティビティに関する情報へのアクセスが削除されることを理解しています。"],"sCbKs4":["この保護者とのつながりを切断すると、私のDiscordアクティビティに関する情報への相手のアクセスが削除されることを理解しています。"],"o0JXuK":[[1,"username"],"さんからのつながりを切断しますか？"],"WH+Gba":["これにより、このアカウントと保護者とのつながりが削除されます。"],"F2lccv":["これにより、つながっている保護者から",[1,"username"],"さんが削除されます"],"Or6hgl":["お住まいの地域の法律により、13～16歳のユーザーにはつながっている保護者が必要です。つながっている保護者がいない場合、",[1,"username"],"さんはDiscordへのアクセスを継続できません。"],"hOEHFn":["お住まいの地域の法律により、13～16歳のユーザーにはつながっている保護者が必要です。つながっている保護者がいない場合、Discordへのアクセスを継続することはできません。"],"Xt6oND":["過去",[1,"days"],"日間にわたりアクティビティはありません"],"VjIAQQ":["今日のアクティビティはありません"],"2a8xHY":["昨日以降のアクティビティはありません"],"GKzqWi":["ファミリーセンターでは最大8アカウントとつながることができます。別のアカウントを追加するには、まずつながっているアカウントを削除する必要があります。詳しくは、",[8,"$link",["ヘルプセンター"],[[1,"link"]]],"をご覧ください。"],"bS5x94":["つながり数の上限に到達しました！"],"69F+eS":["ファミリーセンターでは最大3アカウントとつながれます。別のアカウントを追加するには、まずつながっているアカウントを削除する必要があります。詳しくは、",[8,"$link",["ヘルプセンター"],[[1,"link"]]],"をご覧ください。"],"MzX4RP":["つながり数の上限に到達しました！"],"Uss2dn":["後でもう一度お試しください。"],"nGX8Co":["問題が発生しました。"],"Wu8BK2":["何か問題があるようです！しばらくしてからもう一度お試しください。"],"xNEkdx":["10代のお子様は、ファミリーセンターであなたの申請を受け入れることができます。申請が受け入れまたは拒否されると、",[1,"email"],"にメールが届きます。"],"Xyjnwn":["10代のお子様は、ファミリーセンターであなたの申請を受け入れることができます。申請が受け入れまたは拒否されると、あなたのメールアドレスにメールが届きます。"],"tu0MRv":["つながり申請は既に送信されました！"],"On5iRI":["詳しくは",[8,"$link",["ヘルプセンター"],[[1,"link"]]],"をご覧ください。"],"W9JLJh":["保護者としてこの10代のユーザーとつながるには、19歳以上である必要があります"],"6JkHSg":["ファミリーセンターが必要な理由"],"bmhCnL":["10代のお子様のプライバシーを尊重しながら、誰とトークしているかを閲覧できます。"],"qITXhY":["保護者の方はあなたのメッセージのプライベートな内容を見ることはできません"],"001l3m":["メッセージはプライベートのまま"],"1xPTwE":["10代のお子様が表示するQRコードをお使いのスマートフォンでスキャンするだけで、簡単に設定できます。"],"+pi4Yt":["保護者の方にQRコードを提示してスキャンしてもらうと、簡単に設定できます。"],"hhOuMe":["つながるのは簡単"],"68zfxD":["保護者の皆様とお子様は全く同じ情報を閲覧できるため、同じ認識を持つことができます。"],"t7SkFy":["あなたと保護者の方は同じ情報を閲覧できるため、同じ認識を持つことができます。"],"yipAeP":["透明性が確保された共有"],"KOwsf/":["741741にDISCORDとメッセージを送ると、クライシス・テキストラインでトレーニングを受けたボランティアのクライシス・カウンセラーと週7日24時間いつでも会話できます。Discordとクライシス・テキストラインの提携について、",[8,"$link",["詳しくはこちら"],[[1,"helpLink"]]]],"7/tVhv":["さらなるサポートが必要ですか？"],"Mi60fm":["保護者にこのコードをスキャンしてもらいましょう"],"Q8XnAa":["保留中の申請 — ",[1,"count"],"件"],"IkAgkG":["受信した保護者申請 — ",[1,"cou