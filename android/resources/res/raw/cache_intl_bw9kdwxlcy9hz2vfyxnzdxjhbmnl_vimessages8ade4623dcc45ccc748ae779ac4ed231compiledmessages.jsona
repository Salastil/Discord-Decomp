{"Z61nkt":["Yêu Cầu Xem Xét Thủ Công"],"2+f8w1":["Quá trình xem xét thủ công của chúng tôi đã xác định rằng bạn thuộc nhóm tuổi thanh thiếu niên (",[1,"teenAgeRange"],"), nên ",[8,"contentAndSettingsHook",["nội dung và cài đặt"]]," dành cho người lớn không khả dụng. Bạn có thể xác nhận lại nhóm tuổi của mình sau."],"AA3xYb":["Hiện không thể xác nhận nhóm tuổi của bạn"],"RFLH++":["Bạn đã thử xác nhận nhóm tuổi của mình rồi. Nếu hiện tại bạn không thấy một phương thức nào đó, nó có thể sẽ khả dụng lại sau, hoặc bạn có thể yêu cầu xem xét thủ công."],"+c5sxg":["Vui lòng đợi trước khi thử lại"],"agiNYw":["42178056096663"],"14Fje3":["Bạn chỉ có thể có một yêu cầu xem xét đang xử lý tại một thời điểm. Bạn sẽ nhận được kết quả trong vòng 48-72 giờ sau khi gửi và sẽ không thể thử các phương pháp khác cho đến lúc đó."],"CNm4w6":["Đang tiến hành xem xét thủ công"],"vPoM8y":["Không thể xác định tuổi của bạn. Bạn có thể thử lại hoặc ",[8,"manualReviewHook",["yêu cầu xét duyệt thủ công"]],"."],"yV/t/V":["Qua đánh giá thủ công, chúng tôi xác định bạn không đáp ứng yêu cầu độ tuổi tối thiểu ở khu vực của mình. Bạn không thể thử lại bằng các phương thức khác vào thời điểm này."],"rn3Gto":["Tài khoản của bạn đã bị đình chỉ vĩnh viễn và sẽ bị đã xóa vì bạn không đáp ứng yêu cầu độ tuổi tối thiểu tại khu vực mình"],"vPOpia":["Để duy trì tài khoản trong tương lai ở trạng thái đánh giá tốt, hãy tuân thủ các ",[8,"$link",["Điều Khoản Dịch Vụ"],[[1,"tosLink"]]]," và ",[8,"$link",["Nguyên Tắc Cộng Đồng"],[[1,"communityGuidelinesLink"]]]," của chúng tôi."]}