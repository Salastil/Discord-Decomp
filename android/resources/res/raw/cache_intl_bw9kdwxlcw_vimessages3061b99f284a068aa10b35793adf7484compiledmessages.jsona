{"8TWztV":["Nhóm tuổi sẽ quyết định liệu bạn có thể truy cập nội dung và cài đặt dành cho người lớn hay không. Bạn thuộc nhóm tuổi người lớn, nên sẽ không có gì thay đổi với bạn. ",[8,"$link",["Tìm hiểu thêm trên blog của chúng tôi"],[[1,"handleOnBlogHook"]]]],"qSkhZH":["Nhóm tuổi sẽ quyết định liệu bạn có thể truy cập nội dung và cài đặt dành cho người lớn hay không. Ngoài ra, mọi thứ trên Discord vẫn y nguyên. Xem nhóm tuổi của bạn bên dưới và ",[8,"$link",["tìm hiểu thêm trên blog của chúng tôi"],[[1,"handleOnBlogHook"]]],"."],"vGxRDB":["Nhóm tuổi sẽ quyết định liệu bạn có thể truy cập nội dung và cài đặt dành cho người lớn hay không. Ngoài ra, mọi thứ trên Discord vẫn y nguyên. Xem nhóm tuổi của bạn bên dưới và ",[8,"$link",["tìm hiểu thêm trên blog của chúng tôi"],[[1,"handleOnBlogHook"]]],"."],"gi4ulu":["Bạn thuộc nhóm tuổi người lớn (18+) và có quyền truy cập vào ",[8,"$link",["các nội dung, không gian và cài đặt bị giới hạn độ tuổi"],[[1,"handleOnAgeGatedContentHook"]]],"."],"221iML":["Bạn thuộc nhóm tuổi thanh thiếu niên (13-17) nên có thêm các biện pháp bảo vệ, đồng thời ",[8,"$link",["nội dung và cài đặt"],[[1,"handleOnAgeGatedContentHook"]]]," dành cho người lớn sẽ không khả dụng. Nếu nhóm tuổi của bạn không đúng, bạn có thể ",[8,"$link",["xác nhận bạn là người lớn"],[[1,"handleOnConfirmAgeHook"]]],"."],"W0/7DD":["Nhóm tuổi của bạn chưa được xác nhận, nên ",[8,"$link",["một số nội dung và cài đặt"],[[1,"handleOnAgeGatedContentHook"]]]," dành cho người lớn sẽ không khả dụng cho đến khi bạn ",[8,"$link",["xác nhận bạn là người lớn"],[[1,"handleOnConfirmAgeHook"]]],"."],"t5QjmQ":["Bạn thuộc nhóm tuổi người lớn"],"41MDhK":["Bạn thuộc nhóm tuổi thanh thiếu niên"],"m95jW8":["Nhóm tuổi của bạn chưa được xác nhận"],"iK0n30":["Kênh này được quản trị viên của ",[1,"guildName"]," giới hạn cho người lớn (18+) và có thể chứa nội dung nhạy cảm."],"ezJA0R":["Kênh này được quản trị viên của ",[1,"guildName"]," giới hạn cho người lớn (18+) và có thể chứa nội dung nhạy cảm. Tài khoản của bạn thuộc nhóm tuổi thanh thiếu niên. Nếu nhóm tuổi của bạn không đúng, hãy xác nhận rằng bạn là người lớn."],"h4HbnI":["Kênh này được quản trị viên của ",[1,"guildName"]," giới hạn cho người lớn (18+) và có thể chứa nội dung nhạy cảm. Xác nhận bạn là người lớn để truy cập các nội dung, không gian và cài đặt bị giới hạn độ tuổi."],"qbBkFI":["Bạn thuộc nhóm tuổi thanh thiếu niên, nên không thể thay đổi một số cài đặt. Nếu điều này có vẻ không đúng, bạn có thể ",[8,"$link",["xác nhận bạn là người lớn"],[[1,"handleOnConfirmAgeHook"]]],"."],"HGJo1F":["Một số cài đặt chỉ có thể thay đổi nếu bạn thuộc nhóm tuổi người lớn. ",[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnAgeGatedContentHook"]]]],"l+jt8J":["Bạn thuộc nhóm tuổi thanh thiếu niên, nên không thể tắt Yêu cầu tin nhắn. Nếu điều này có vẻ không đúng, bạn có thể ",[8,"$link",["xác nhận bạn là người lớn"],[[1,"handleOnConfirmAgeHook"]]],"."],"tGsCdS":["Bạn chỉ có thể tắt Yêu cầu tin nhắn nếu thuộc nhóm tuổi người lớn. ",[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnAgeGatedContentHook"]]]],"cI+bc/":["Xác Nhận Tuổi"],"+7NlgO":["Tìm hiểu thêm"],"GdTVPF":["Chúng tôi đã khởi chạy các biện pháp bảo vệ bổ sung cho thanh thiếu niên"],"jjpcno":["Xem trong Cài đặt"],"Ga2z/E":["Tài khoản của bạn thuộc nhóm tuổi thanh thiếu niên, nên nội dung và cài đặt dành cho người lớn sẽ không khả dụng. Ngoài ra, Discord vẫn hoạt động như bình thường. ",[8,"$link",["Nếu chúng tôi nhầm, hãy xác nhận bạn là người lớn"],[[1,"handleOnConfirmAgeHook"]]],"."],"xuvWqy":["Nhóm tuổi của bạn vẫn chưa được xác nhận, nên một số nội dung và cài đặt dành cho người lớn sẽ không khả dụng. Ngoài ra, Discord vẫn hoạt động như bình thường. ",[8,"$link",["Tìm hiểu thêm trên blog của chúng tôi"],[[1,"handleOnBlogHook"]]],"."]}