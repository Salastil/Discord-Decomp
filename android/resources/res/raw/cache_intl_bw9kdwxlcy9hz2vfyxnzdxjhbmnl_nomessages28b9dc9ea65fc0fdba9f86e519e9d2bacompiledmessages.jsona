{"Z61nkt":["Be om en manuell gjennomgang"],"2+f8w1":["Etter en manuell gjennomgang fastslo vi at du er i aldersgruppen ungdom (",[1,"teenAgeRange"],"), så du har ikke tilgang til ",[8,"contentAndSettingsHook",["innhold og innstillinger"]]," for voksne. Det er mulig at du kan bekrefte aldersgruppen din igjen senere."],"AA3xYb":["Det er ikke mulig å bekrefte aldersgruppe nå"],"RFLH++":["Du har allerede prøvd å bekrefte aldersgruppen din. Metoder du ikke ser, kan bli tilgjengelige igjen senere, eller du kan be om en manuell gjennomgang."],"+c5sxg":["Vent før du prøver igjen"],"agiNYw":["42178056096663"],"14Fje3":["Kun én vurdering kan gjøres om gangen. Du får resultatet mellom 48 og 72 timer etter innsending, og du kan ikke prøve andre metoder før det."],"CNm4w6":["Manuell gjennomgang pågår"],"vPoM8y":["Vi klarer ikke å fastslå alderen din. Prøv på nytt eller ",[8,"manualReviewHook",["be om en manuell gjennomgang"]],"."],"yV/t/V":["Etter en manuell gjennomgang har vi fastslått at du er under minstealderen i regionen din. Du kan per i dag ikke prøve igjen med andre metoder."],"rn3Gto":["Kontoen din er utestengt for godt og kommer til å bli slettet, siden du er under minstealderen i regionen din"],"vPOpia":["For å holde fremtidige kontoer i god skikk bør du gjøre deg kjent med ",[8,"$link",["bruksvilkårene"],[[1,"tosLink"]]]," og ",[8,"$link",["retningslinjene for fellesskapet"],[[1,"communityGuidelinesLink"]]],"."]}