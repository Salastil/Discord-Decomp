{"5Mi5TE":["Thay đổi cách chúng tôi chỉ định tuổi của bạn?"],"lG69e1":[[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnHelpUrlHook"]]]," về các nhóm tuổi"],"V822Mp":["Gỡ bỏ nhóm tuổi"],"FbTAmI":["Thao tác này sẽ thay đổi nhóm tuổi của bạn từ Người Lớn sang Chưa Xác Nhận và bạn sẽ không thể truy cập vào các trải nghiệm giới hạn độ tuổi. Để lấy lại quyền truy cập của người lớn, bạn sẽ cần xác nhận nhóm tuổi bằng một phương thức khác."],"Gn0SAj":["Đặt nhóm tuổi của bạn thành Chưa Xác Nhận"],"bD//cU":["Gỡ bỏ nhóm tuổi đã được chỉ định"],"rJiO86":["Chọn để xác nhận nhóm tuổi của bạn bằng một phương thức khác"],"SH6Tcv":["Xác nhận nhóm tuổi"],"1DN29p":["Chúng tôi sử dụng công nghệ để đánh giá nhóm tuổi người dùng dựa trên mô hình hành vi và các tín hiệu khác liên quan đến tài khoản người dùng trên Discord. ",[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnHelpUrlHook"]]]],"PY4MA0":["Bạn đã được Discord chỉ định nhóm tuổi Người Lớn"],"FTawSP":["Được Discord chỉ định"],"VcZF1q":["Tiếp tục trong cửa sổ khác. Nếu muốn chọn phương thức xác nhận độ tuổi khác, hãy tắt cửa sổ và quay lại đây."],"MLPgsX":["Bạn đang xác nhận tuổi của mình trong một cửa sổ khác"],"9F2y52":["Chúng tôi không thể xác nhận tuổi của bạn bằng ảnh bạn tự chụp. Thử lại?"],"40UKek":["Chúng tôi không thể xác nhận tuổi của bạn bằng quét ID. Thử lại?"],"yBHwMy":["Bước này không được hỗ trợ trên VR. Hoàn thành nó trên một thiết bị khác và chúng tôi sẽ tự động cập nhật trải nghiệm của bạn ở đây."],"gUqXQN":["Xác nhận tuổi của bạn trên một thiết bị khác"],"Jx33+I":["Thử phương thức khác"],"XBGt7g":["Chúng tôi xác định bạn chưa đủ tuổi tối thiểu của Discord."],"tBwanH":["Chúng tôi không thể xác nhận nhóm tuổi của bạn với App Store. Vui lòng thử cách khác."],"MN6I4Y":["Đang xác nhận nhóm tuổi của bạn…"],"RpMIT0":["Chọn một phương thức để xác nhận bạn là người lớn. Sau khi xác nhận, bạn có thể truy cập nội dung và cài đặt giới hạn độ tuổi. ",[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnHelpUrlHook"]]],"."],"h7qzoa":["Khôi phục quyền truy cập Discord bằng cách xác nhận tuổi của bạn bằng một trong các tùy chọn bên dưới."],"+Ft5ch":["Nếu được xác nhận là người lớn (18+), bạn sẽ có quyền truy cập vào nội dung và cài đặt giới hạn độ tuổi. Cần trợ giúp? Xem ",[8,"$link",["cách xác nhận"],[[1,"handleOnHelpUrlHook"]]]," hoặc tìm hiểu về ",[8,"$link",["các nhà cung cấp đáng tin cậy"],[[1,"handleOnTrustedProvidersHook"]]],"."],"22HSSI":["Nếu được xác nhận là người lớn (18+), bạn sẽ có quyền truy cập vào nội dung và cài đặt giới hạn độ tuổi. Cần trợ giúp? Xem ",[8,"$link",["cách xác nhận"],[[1,"handleOnHelpUrlHook"]]],"."],"/kgWIg":["Xác nhận nhóm tuổi của bạn"],"eJmat5":["Ước tính độ tuổi của bạn bằng một video tự quay. Video được giữ trên thiết bị, không có dữ liệu sinh trắc học nào được chia sẻ."],"2yLvkS":["Video selfie qua k-ID"],"+pwfOA":["Đã xảy ra lỗi khi xác minh Google Wallet. Vui lòng thử phương thức khác."],"dah4bF":["Sử dụng ID Pass dựa trên thông tin hộ chiếu của bạn. Chi tiết ID của bạn được giữ trong Google Wallet."],"Y9sLpR":["ID Pass Google Wallet"],"fEUKEv":["Thử phương thức khác"],"Pf5xUq":["ID của bạn được cấp ở một quốc gia chưa được hỗ trợ. Vui lòng thử phương thức xác minh khác."],"MlFuBI":["Đang xác minh độ tuổi của bạn…"],"ZdmRwW":["Quét ID của bạn và tự chụp một bức ảnh để xác nhận đó là bạn. Cả hai sẽ bị xóa ngay sau khi xác nhận và không bao giờ được liên kết với tài khoản của bạn."],"dwkwo0":["Quét ID qua k-ID"],"ARmJ0M":["Sử dụng bằng lái xe, hộ chiếu hoặc ID khác do chính phủ cấp."],"NeVlw/":["Quét ID của bạn"],"eZvwAe":["Bạn muốn xác minh tuổi của mình như thế nào?"],"5yWXmT":["Chọn lựa chọn phù hợp nhất với bạn."],"fm7qBC":["Tùy chọn nhanh nhất. Dữ liệu sinh trắc học của bạn được xử lý cục bộ và không bao giờ rời khỏi thiết bị của bạn."],"rgXXcW":["Tự chụp chân dung"],"htWh1G":[[8,"$link",["Tìm hiểu thêm"],[[1,"handleOnHelpUrlHook"]]]," tại Trung Tâm Trợ Giúp của chúng tôi"],"Bkmk4Y":["Đã có lỗi khi tải phương thức xác minh. Vui lòng thử lại."],"vVwFCK":["Phương thức nà