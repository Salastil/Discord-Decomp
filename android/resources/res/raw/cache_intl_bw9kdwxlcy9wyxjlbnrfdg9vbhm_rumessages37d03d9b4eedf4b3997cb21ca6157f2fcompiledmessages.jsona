т расходов"],"KBgArX":["Включает личные сообщения и групповые чаты"],"Z3G+8h":["Пользователи, с которыми велись разговоры или переписка"],"Ief2xc":["Продолжительность разговоров на серверах, в личных и групповых чатах (в минутах)."],"GNs2ZH":["Общее время голосовых и видеозвонков"],"LcM8BS":["Если вы отклоните запрос вашего родителя, мы отправим ему уведомление об этом."],"cXgKMD":["Объявление"],"teIRCR":["Отклонить запрос на подключение учётной записи родителя?"],"dKxFcn":["Отклонить"],"c5L+sl":["Отключиться"],"PlrZal":["Если вы отключитесь от учётной записи пользователя ",[1,"username"],", мы отправим ему уведомление. Вы также больше не сможете видеть его действия в Discord."],"XyRW4c":["Если вы отключитесь от учётной записи пользователя ",[1,"username"],", мы отправим ему уведомление. Он также больше не сможет видеть ваши действия в Discord."],"PGQBnk":["Я понимаю, что для доступа к Discord у подростка должна быть подключена хотя бы одна учётная запись доверенного взрослого."],"eiABQz":["Я понимаю, что для доступа к Discord у меня должна быть подключена хотя бы одна учётная запись доверенного взрослого."],"0ki7+P":["Я понимаю, что не смогу просматривать информацию о действиях подростка в Discord после отключения учётной записи."],"sCbKs4":["Я понимаю, что взрослый не сможет просматривать информацию о моих действиях в Discord после отключения учётной записи."],"o0JXuK":["Отключиться от учётной записи пользователя ",[1,"username"],"?"],"WH+Gba":["Вы удалите подключение к этой учётной записи."],"F2lccv":["Вы удалите пользователя ",[1,"username"]," из списка подключённых взрослых."],"Or6hgl":["По законам региона, в котором находится этот пользователь, подростки в возрасте от 13 до 16 лет обязаны подключить учётную запись доверенного взрослого. Без этого ",[1,"username"]," не сможет пользоваться Discord."],"hOEHFn":["По законам вашего региона подростки в возрасте от 13 до 16 лет обязаны подключить учётную запись доверенного взрослого. Без этого вы не сможете пользоваться Discord."],"Xt6oND":["Нет действий за последние ",[1,"days"]," дн."],"VjIAQQ":["Нет действий за сегодня"],"2a8xHY":["Не действий со вчерашнего дня"],"GKzqWi":["Вы можете подключить до 8 учётных записей в семейном центре. Чтобы добавить ещё одну учётную запись, вы сначала должны удалить одну из уже подключённых. Подробнее вы можете узнать в нашем ",[8,"$link",["справочном центре"],[[1,"link"]]],"."],"bS5x94":["Вы достигли лимита подключений!"],"69F+eS":["Вы можете подключить до 3 учётных записей в семейном центре. Чтобы добавить ещё одну учётную запись, вы сначала должны удалить одну из уже подключённых. Подробнее вы можете узнать в нашем ",[8,"$link",["справочном центре"],[[1,"link"]]],"."],"MzX4RP":["Вы достигли лимита подключений!"],"Uss2dn":["Повторите попытку позже."],"nGX8Co":["Что-то пошло не так!"],"Wu8BK2":["Что-то пошло не так! Повторите попытку позже."],"xNEkdx":["Ваш ребёнок может принять запрос в семейном центре. Когда он примет или отклонит этот запрос, вы получите письмо на электронную почту ",[1,"email"],"."],"Xyjnwn":["Ваш ребёнок может принять ваш запрос в семейном центре. После того, как он одобрит или отклонит ваш запрос, вы получите письмо на вашу электронную почту."],"tu0MRv":["Запрос на подключение уже отправлен!"],"On5iRI":["Подробнее вы можете узнать в нашем ",[8,"$link",["справочном центре"],[[1,"link"]]],"."],"W9JLJh":["Чтобы подключить родительскую учётную запись к учётной записи этого ребёнка, вы должны быть старше 18 лет."],"6JkHSg":["Для чего нужен семейный центр?"],"bmhCnL":["Вы будете знать, с кем общается ваш ребёнок, не нарушая при этом его личное пространство."],"qITXhY":["Опекуны не увидят содержание ваших сообщений"],"001l3m":["Сообщения остаются конфиденциальными"],"1xPTwE":["Для подключения вам всего лишь нужно отсканировать отправленный вашим ребёнком QR-код."],"+pi4Yt":["Всё очень просто настроить. Попросите опекуна сканировать QR-код, который вы ему покажете."],"hhOuMe":["Легко подключиться"],"68zfxD":["Вы и ваш ребёнок видите одну и ту же информацию, поэтому находитесь в равных условиях."],"t7SkFy":["Вы и ваш опекун видите одну и ту же информацию, поэтому находитесь в равных условиях."],"yipAeP":["Прозрачность раскрываемых данных"],"KOwsf/":["Отправьте сообщение с текстом DISCORD по номеру 741741, чтобы пообщаться с квалифицированным кризисным психологом организации Crisis Text Line, предоставляющей круглосуточную поддержку. ",[8,"$link",["Подробнее"],[[1,"helpLink"]]]," о нашем сотрудничестве с Crisis Text Line"],"7/tVhv":["Нужна дополнительная поддержка?"],"Mi60fm":["Попросите вашего опекуна сканировать этот код"],"Q8XnAa":["ЗАПРОСОВ, ОЖИДАЮЩИХ ПОДТВЕРЖДЕНИЯ, — ",[1,"count"]],"IkAgkG":["ВХОДЯЩИЕ ЗАПРОСЫ ОТ РОДИТЕЛЕЙ — ",[1,"count"]],"MP3khg":["Запрос отправлен ",[1,"date"]],"pWig18":["Запрос отправлен ",[2,"count"]," ",[6,"count",{"one":["день"],"few":["дня"],"other":["дней"]},0,"cardinal"]," назад"],"ErkYCI":["Запрос отправлен ",[2,"count"]," ",[6,"count",{"one":["час"],"few":["часа"],"other":["часов"]},0,"cardinal"]," назад"],"InzMn3":["Запрос отправлен ",[2,"count"]," ",[6,"count",{"one":["минуту"],"few":["минуты"],"other":["минут"]},0,"cardinal"]," назад"],"CJdoee":["Запрос отправлен < 1 минуты назад"],"GvfssA":["Запрос отправлен вчера"],"jcUN2F":["Действие ссылок для подключения опекуна истечёт через час. Попросите подростка отправить вам новую ссылку или сканируйте QR-код в его Семейном центре."],"ewSb6o":["Срок действия этой ссылки истёк"],"WDjaKn":["Вы не достигли минимального возраста для того, чтобы стать опекуном. Если вам кажется, что произошла ошибка, попробуйте ",[8,"$link",["подтвердить возраст"],[[1,"link"]]]," ещё раз."],"BQFHXW":["Опекуну должно быть не менее 18 лет"],"z4a9HP":["Подключиться к учётной записи ребёнка"],"RcTgiE":["В семейном центре вы можете подключиться максимум к ",[2,"maxConnections"]," учётным записям ваших детей. Чтобы добавить ещё одну учётную запись, вам сначала нужно удалить одну из указанных выше подключённых учётных записей."],"1/PzIj":