<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="./data/user/0/com.discord.debug/lib-0/"/>
        <exclude
            domain="root"
            path="./data/data/com.discord.debug/lib-0/"/>
        <exclude
            domain="root"
            path="./data/user/0/com.discord/lib-0/"/>
        <exclude
            domain="root"
            path="./data/data/com.discord/lib-0/"/>
        <exclude
            domain="sharedpref"
            path="appsflyer-data"/>
        <exclude
            domain="sharedpref"
            path="com.discord.notifications.service.HorizonPushTokenStore"/>
        <exclude
            domain="sharedpref"
            path="jank_session"/>
        <exclude
            domain="sharedpref"
            path="jank_session_live"/>
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="appsflyer-data"/>
        <exclude
            domain="sharedpref"
            path="com.discord.notifications.service.HorizonPushTokenStore"/>
        <exclude
            domain="sharedpref"
            path="jank_session"/>
        <exclude
            domain="sharedpref"
            path="jank_session_live"/>
    </device-transfer>
</data-extraction-rules>
