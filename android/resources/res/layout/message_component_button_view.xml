<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="0px"
        android:layout_height="match_parent"
        android:minHeight="32dp"
        android:insetLeft="0px"
        android:insetRight="0px"
        android:insetTop="0px"
        android:insetBottom="0px"
        android:stateListAnimator="@null"
        app:cornerRadius="8dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/label_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:importantForAccessibility="noHideDescendants"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.span.SimpleDraweeSpanTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/emoji"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            app:actualImageScaleType="fitCenter"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/label"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            app:layout_constrainedWidth="true"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/link_icon"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/loading_dots"
        android:visibility="gone"
        android:layout="@layout/component_loading_dots"
        android:inflatedId="@+id/loading_dots"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
