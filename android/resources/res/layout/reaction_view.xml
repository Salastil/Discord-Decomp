<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/reaction_label_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"/>
    <com.facebook.drawee.span.SimpleDraweeSpanTextView
        android:gravity="center_vertical"
        android:id="@+id/reaction_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextSwitcher
        android:id="@+id/reaction_count_switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:layout_marginStart="6dp">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/reaction_count_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/reaction_count_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </TextSwitcher>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/reaction_label_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
</merge>
