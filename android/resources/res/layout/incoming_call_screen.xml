<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/incoming_call_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:noHistory="true">
    <LinearLayout
        android:background="#20000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/imageView"
        android:layout_width="96sp"
        android:layout_height="96sp"
        android:layout_marginTop="120sp"
        android:layout_marginBottom="18sp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="no"/>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/round_button"
        android:padding="6sp"
        android:layout_width="32sp"
        android:layout_height="32sp"
        android:layout_marginTop="-48sp"
        android:src="@mipmap/img_logo_dark"
        android:layout_below="@+id/imageView"
        android:importantForAccessibility="no"
        android:layout_alignEnd="@+id/imageView"
        android:backgroundTint="@color/brand"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/textContainer"
        android:paddingLeft="40sp"
        android:paddingRight="40sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40sp"
        android:layout_below="@+id/imageView"
        android:paddingHorizontal="40sp">
        <TextView
            android:textSize="32sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/userName"
            android:paddingBottom="8sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42sp"
        android:layout_below="@+id/textContainer"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/buttonLabels">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/declineButton"
                android:layout_width="168sp"
                android:layout_height="wrap_content">
                <ImageButton
                    android:layout_gravity="center"
                    android:id="@+id/declineCallContainer"
                    android:background="@drawable/round_button"
                    android:layout_width="64sp"
                    android:layout_height="64sp"
                    android:layout_centerHorizontal="true"
                    android:contentDescription="@null"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/acceptButton"
                android:layout_width="168sp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">
                <ImageButton
                    android:layout_gravity="end"
                    android:id="@+id/acceptCallContainer"
                    android:background="@drawable/round_button"
                    android:layout_width="64sp"
                    android:layout_height="64sp"
                    android:layout_centerHorizontal="true"
                    android:contentDescription="@null"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/buttonLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32sp"
            android:layout_marginRight="32sp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="32sp">
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/declineCallText"
                android:clickable="false"
                android:layout_width="104sp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/acceptCallText"
                android:clickable="false"
                android:layout_width="104sp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
