<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/message_start_guideline"/>
    <View
        android:id="@+id/left_border"
        android:visibility="gone"
        android:layout_width="@dimen/message_gutter_width"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/premium_system_left_border_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/message_start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/system_icon"
        android:layout_width="@dimen/system_message_icon_size"
        android:layout_height="@dimen/system_message_icon_size"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/message_start_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/premium_icon"
        android:visibility="gone"
        android:layout_width="@dimen/premium_system_icon_size"
        android:layout_height="@dimen/premium_system_icon_size"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/premium_system_icon_margin_start"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/message_start_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/gifting_prompt_icon_container"
        android:background="@drawable/gifting_prompt_icon_background"
        android:padding="@dimen/gifting_prompt_icon_padding"
        android:visibility="gone"
        android:layout_width="@dimen/gifting_prompt_icon_container_size"
        android:layout_height="@dimen/gifting_prompt_icon_container_size"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/message_start_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/gifting_prompt_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:actualImageScaleType="fitCenter"/>
    </FrameLayout>
    <com.discord.chat.presentation.message.MessageAccessoriesView
        android:id="@+id/accessories_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
