<?xml version="1.0" encoding="utf-8"?>
<com.discord.chat.presentation.message.view.GiftIntentView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/gift_intent_card_corner_radius"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/gift_intent_card_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="@dimen/gift_intent_avatar_container_size"
                android:layout_height="@dimen/gift_intent_avatar_container_size"
                android:importantForAccessibility="yes">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/current_user_avatar"
                    android:layout_width="@dimen/gift_intent_avatar_size"
                    android:layout_height="@dimen/gift_intent_avatar_size"
                    android:importantForAccessibility="no"
                    app:actualImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
                <View
                    android:id="@+id/recipient_avatar_cutout"
                    android:background="@drawable/drawable_circle"
                    android:layout_width="@dimen/gift_intent_avatar_cutout_size"
                    android:layout_height="@dimen/gift_intent_avatar_cutout_size"
                    android:layout_marginTop="@dimen/gift_intent_avatar_cutout_offset"
                    android:layout_marginStart="@dimen/gift_intent_avatar_cutout_offset"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/recipient_avatar"
                    android:layout_width="@dimen/gift_intent_avatar_size"
                    android:layout_height="@dimen/gift_intent_avatar_size"
                    android:layout_marginTop="@dimen/gift_intent_front_avatar_offset"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/gift_intent_front_avatar_offset"
                    app:actualImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/text_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gift_intent_text_leading">
                <TextView
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:id="@+id/header_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sub_header_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gift_intent_sub_header_top"
                    android:baselineAligned="false">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/sub_header_icon"
                        android:layout_width="@dimen/gift_intent_sub_header_icon_size"
                        android:layout_height="@dimen/gift_intent_sub_header_icon_size"
                        app:actualImageScaleType="fitCenter"/>
                    <TextView
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:id="@+id/sub_header_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/gift_intent_sub_header_gap"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cta_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gift_intent_cta_row_top"
            android:baselineAligned="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/primary_cta_button"
                android:background="@drawable/gift_intent_cta_background"
                android:layout_width="0dp"
                android:layout_height="@dimen/gift_intent_cta_height"
                android:layout_weight="1"
                android:paddingStart="@dimen/gift_intent_primary_cta_horizontal_padding"
                android:paddingEnd="@dimen/gift_intent_primary_cta_horizontal_padding">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/primary_cta_icon"
                    android:layout_width="@dimen/gift_intent_cta_icon_size"
                    android:layout_height="@dimen/gift_intent_cta_icon_size"
                    android:importantForAccessibility="no"
                    app:actualImageScaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/primary_cta_label"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:id="@+id/primary_cta_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/gift_intent_cta_icon_text_gap"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/primary_cta_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/secondary_cta_button"
                android:background="@drawable/gift_intent_cta_background"
                android:layout_width="@dimen/gift_intent_secondary_cta_size"
                android:layout_height="@dimen/gift_intent_secondary_cta_size"
                android:layout_marginStart="@dimen/gift_intent_cta_gap">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/secondary_cta_icon"
                    android:layout_width="@dimen/gift_intent_cta_icon_size"
                    android:layout_height="@dimen/gift_intent_cta_icon_size"
                    android:importantForAccessibility="no"
                    app:actualImageScaleType="fitCenter"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.discord.chat.presentation.message.view.GiftIntentView>
